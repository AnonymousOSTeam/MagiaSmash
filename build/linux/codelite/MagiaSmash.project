      <File Name="../../../data/config/MagiaSmashd.ini"/>
      <File Name="../../../data/config/MagiaSmashp.ini"/>
      <File Name="../../../data/config/SettingsTemplate.ini"/>
    </VirtualDirectory>
    <VirtualDirectory Name="include">
      <File Name="../../../include/Fighter.h"/>
      <File Name="../../../include/GameHUD.h"/>
      <File Name="../../../include/MagiaSmash.h"/>
      <VirtualDirectory Name="extensions">
        <VirtualDirectory Name="AtariAudio">
          <File Name="../../../include/extensions/AtariAudio/AtariAudio.h"/>
