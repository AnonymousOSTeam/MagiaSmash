		<Build>
			<Target title="Debug|x64">
				<Option output="../../../bin/MagiaSmashd" prefix_auto="0" extension_auto="0" />
				<Option object_output="obj/x64/Debug" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-ffast-math" />
					<Add option="-g" />
					<Add option="-m64" />
					<Add option="-std=c11" />
					<Add option="-std=c++11" />
					<Add option="-fno-exceptions" />
					<Add option="-DPK_ENABLE_OS=0" />
					<Add option="-D__orxDEBUG__" />
					<Add option="-Wno-write-strings" />
					<Add option="-Wno-multichar" />
					<Add option="-Wno-unused-function" />
					<Add directory="$(ORX)/include" />
					<Add directory="../../../include/extensions/pocketpy" />
					<Add directory="../../../include/extensions" />
					<Add directory="../../../include" />
				</Compiler>
				<Linker>
					<Add option="-static-libgcc" />
					<Add option="-static-libstdc++" />
					<Add option="-m64" />
					<Add option="-L/usr/lib64" />
					<Add option="-Wl,-rpath ./" />
					<Add option="-Wl,--export-dynamic" />
					<Add directory="$(ORX)/lib/dynamic" />
					<Add directory="." />
					<Add library="orxd" />
					<Add library="dl" />
					<Add library="m" />
					<Add library="rt" />
				</Linker>
				<ExtraCommands>
					<Add after="cp -f $(ORX)/lib/dynamic/liborx*.so ../../../bin" />
				</ExtraCommands>
			</Target>
